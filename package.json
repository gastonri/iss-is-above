{
    "name": "iss-is-above",
    "version": "2.0.0",
    "description": "Live tracker that shows where the ISS is right now, what it is flying over, and a photo of the place.",
    "private": true,
    "type": "module",
    "homepage": "https://gastonri.github.io/iss-is-above",
    "author": "Gastón Rivata",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "leaflet": "^1.9.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-leaflet": "^5.0.0"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.23",
        "@types/node": "^26.6.10",
        "@types/react": "^19.3.3",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "typescript": "^7.0.2",
        "vite": "^6.4.6",
        "vitest": "^4.1.12"
    }
}
